{
    "name": "cdac/rudra",
    "description": "PARAM Rudra 20 PF HPC",

    "scheduler": {
        "type": "slurm",
        "command": "sbatch",
        "default_queue": "debug",

        "default_args": [
            "--mem=180G"
        ],

        "queues": {
            "debug": {
                "min_nodes": 1,
                "max_nodes": 4,
                "min_walltime": "00:05:00",
                "max_walltime": "01:00:00",
                "default_walltime": "01:00:00"
            }
        }
    },

    "hardware": {
        "cores_per_node": 48,
        "gpus_per_node": 0
    }
}
